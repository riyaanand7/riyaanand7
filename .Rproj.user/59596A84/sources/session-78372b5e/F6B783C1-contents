project:
  type: website
  output-dir: _site

website:
  title: "Riya Anand"
  
  # Navigation Bar Styling
  navbar:
    background: "#961464"      # Options: "primary", "dark", "light", or custom hex code like "#0F172A"
    search: true               # Adds an interactive search bar
    pinned: true               # Keeps navbar visible as visitors scroll
    left:
      - text: "Home"
        href: index.qmd
      - text: "Projects"
        href: projects.qmd
      - text: "About"
        href: about.qmd
    right:
      - icon: github
        href: https://github.com/riyaanand7
      - icon: envelope
        href: riya.anand@sciencespo.fr

  # Optional Footer
  page-footer:
    center: "© 2026 Riya Anand • Built with Quarto"
    background: light

format:
  html:
    theme:
      - journal                  # Base Bootswatch theme
      - /custom.scss            # Custom SCSS overrides (see Step 3)
    toc: true                  # Table of contents for longform posts
    toc-location: right
    smooth-scroll: true
    link-external-newwindow: true